generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  CASHIER
  SUPER_ADMIN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         Role          @default(OWNER)
  brands       Brand[]
  branchAccess BranchUser[]
  activityLogs ActivityLog[]
  shiftsOpened Shift[]       @relation("ShiftOpenedBy")
  shiftsClosed Shift[]       @relation("ShiftClosedBy")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum BrandStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Brand {
  id            Int                  @id @default(autoincrement())
  name          String
  imageUrl      String?
  userId        Int
  user          User                 @relation(fields: [userId], references: [id])
  branches      Branch[]
  status        BrandStatus          @default(ACTIVE)
  planId        Int?
  plan          SubscriptionPlan?    @relation(fields: [planId], references: [id])
  planExpiresAt DateTime?
  transactions  PaymentTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([planId])
}

model Branch {
  id                 Int                @id @default(autoincrement())
  name               String
  imageUrl           String?
  brandId            Int
  brand              Brand              @relation(fields: [brandId], references: [id])
  categories         Category[]
  menuItems          MenuItem[]
  kitchens           Kitchen[]
  zones              Zone[]
  optionGroups       OptionGroup[]
  orders             Order[]
  activityLogs       ActivityLog[]
  qrCodeUrl          String?
  pin                String?
  rewardPointRate    Float              @default(100)
  address            String?
  phone              String?
  latitude           Float?
  longitude          Float?
  bankType           String?
  bankAccountNo      String?
  bankAccountName    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  suppliers          Supplier[]
  materialCategories MaterialCategory[]
  rawMaterials       RawMaterial[]
  purchaseOrders     PurchaseOrder[]
  expenses           Expense[]
  customers          Customer[]
  promotions         Promotion[]
  deliveryPlatforms  DeliveryPlatform[]
  shifts             Shift[]
  staffUsers         BranchUser[]

  @@index([brandId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     MenuItem[]
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([branchId])
}

model MenuItem {
  id                  Int                 @id @default(autoincrement())
  name                String
  price               Float
  imageUrl            String?
  categoryId          Int
  category            Category            @relation(fields: [categoryId], references: [id])
  branchId            Int
  branch              Branch              @relation(fields: [branchId], references: [id])
  kitchenId           Int?
  kitchen             Kitchen?            @relation(fields: [kitchenId], references: [id])
  optionGroups        OptionGroup[]
  orderItems          OrderItem[]
  deliveryPrices      MenuDeliveryPrice[]
  isDeliveryAvailable Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([categoryId])
  @@index([branchId])
}

model OptionGroup {
  id         Int        @id @default(autoincrement())
  name       String
  isMultiple Boolean    @default(false)
  branchId   Int
  branch     Branch     @relation(fields: [branchId], references: [id])
  menuItems  MenuItem[]
  options    Option[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([branchId])
}

model Option {
  id            Int               @id @default(autoincrement())
  name          String
  price         Float             @default(0)
  optionGroupId Int
  optionGroup   OptionGroup       @relation(fields: [optionGroupId], references: [id])
  orderOptions  OrderItemOption[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([optionGroupId])
}

model Kitchen {
  id         Int         @id @default(autoincrement())
  name       String
  branchId   Int
  branch     Branch      @relation(fields: [branchId], references: [id])
  items      MenuItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([branchId])
}

model Zone {
  id        Int      @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  tables    Table[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model Table {
  id        Int         @id @default(autoincrement())
  name      String
  qrCode    String      @unique @default(uuid())
  zoneId    Int
  zone      Zone        @relation(fields: [zoneId], references: [id])
  orders    Order[]
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([zoneId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
  COMPLETED
  PAID
}

enum PaymentType {
  CASH
  TRANSFER
}

enum OrderSource {
  CUSTOMER
  STAFF
  QR
}

enum PromotionType {
  PERCENT
  FIXED
  POINTS_REDEMPTION
}

model Order {
  id               Int                 @id @default(autoincrement())
  orderNumber      String              @unique
  status           OrderStatus         @default(PENDING)
  source           OrderSource         @default(CUSTOMER)
  orderType        String              @default("DINE_IN")
  deliveryPlatform String?
  totalAmount      Float
  discountAmount   Float               @default(0)
  paymentType      PaymentType?
  branchId         Int
  branch           Branch              @relation(fields: [branchId], references: [id])
  tableId          Int?
  table            Table?              @relation(fields: [tableId], references: [id])
  customerId       Int?
  customer         Customer?           @relation(fields: [customerId], references: [id])
  promotionId      Int?
  promotion        Promotion?          @relation(fields: [promotionId], references: [id])
  shiftId          String?
  shift            Shift?              @relation(fields: [shiftId], references: [id])
  notes            String?
  items            OrderItem[]
  redemptions      RedemptionHistory[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([branchId])
  @@index([tableId])
  @@index([customerId])
  @@index([shiftId])
}

model Shift {
  id           String      @id @default(uuid())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id])
  status       ShiftStatus @default(OPEN)
  startingCash Float
  actualCash   Float?
  expectedCash Float?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openedById   Int
  openedBy     User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedById   Int?
  closedBy     User?       @relation("ShiftClosedBy", fields: [closedById], references: [id])
  notes        String?     @db.Text
  orders       Order[]
  expenses     Expense[]

  @@index([branchId])
  @@index([openedById])
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
}

model OrderItem {
  id         Int               @id @default(autoincrement())
  orderId    Int
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int
  notes      String?
  kitchenId  Int?
  kitchen    Kitchen?          @relation(fields: [kitchenId], references: [id])
  options    OrderItemOption[]
  status     OrderItemStatus   @default(PENDING)
  createdAt  DateTime          @default(now())

  @@index([orderId])
  @@index([kitchenId])
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId    Int
  option      Option    @relation(fields: [optionId], references: [id])
  name        String
  price       Float

  @@index([orderItemId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([branchId])
}

// ============================================
// INVENTORY MANAGEMENT SYSTEM
// ============================================

model Supplier {
  id          Int             @id @default(autoincrement())
  name        String
  contact     String? // legacy – kept for backward-compat
  phone       String?
  lineId      String?
  bankAccount String?
  bankName    String?
  branchId    Int
  branch      Branch          @relation(fields: [branchId], references: [id])
  orders      PurchaseOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([branchId])
}

model MaterialCategory {
  id        Int           @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch        @relation(fields: [branchId], references: [id])
  materials RawMaterial[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([branchId])
}

model RawMaterial {
  id         Int                 @id @default(autoincrement())
  name       String
  unit       String // e.g. กิโลกรัม, ขวด, ลัง
  stock      Float               @default(0)
  categoryId Int
  category   MaterialCategory    @relation(fields: [categoryId], references: [id])
  branchId   Int
  branch     Branch              @relation(fields: [branchId], references: [id])
  orderItems PurchaseOrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([categoryId])
  @@index([branchId])
}

enum PurchaseOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branchId    Int
  branch      Branch              @relation(fields: [branchId], references: [id])
  status      PurchaseOrderStatus @default(PENDING)
  totalAmount Float               @default(0)
  orderDate   DateTime            @default(now())
  items       PurchaseOrderItem[]
  expense     Expense?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId])
  @@index([branchId])
}

model Expense {
  id              Int            @id @default(autoincrement())
  amount          Float
  description     String?
  paymentMethod   String         @default("CASH") // "CASH" | "TRANSFER"
  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])
  purchaseOrderId Int?           @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  shiftId         String?
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([branchId])
  @@index([shiftId])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterialId   Int
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  quantity        Float
  price           Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([purchaseOrderId, rawMaterialId])
  @@index([purchaseOrderId])
  @@index([rawMaterialId])
}

// ============================================
// MEMBERS & PROMOTIONS SYSTEM
// ============================================

model Customer {
  id          Int                 @id @default(autoincrement())
  phone       String
  name        String
  points      Int                 @default(0)
  branchId    Int
  branch      Branch              @relation(fields: [branchId], references: [id])
  orders      Order[]
  redemptions RedemptionHistory[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([phone, branchId])
  @@index([branchId])
}

model Promotion {
  id           Int                 @id @default(autoincrement())
  name         String
  code         String?
  type         PromotionType
  value        Float
  minSpend     Float               @default(0)
  pointsNeeded Int                 @default(0)
  memberOnly   Boolean             @default(false)
  isActive     Boolean             @default(true)
  startDate    DateTime?
  endDate      DateTime?
  branchId     Int
  branch       Branch              @relation(fields: [branchId], references: [id])
  orders       Order[]
  redemptions  RedemptionHistory[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([branchId])
}

model RedemptionHistory {
  id             Int       @id @default(autoincrement())
  customerId     Int
  customer       Customer  @relation(fields: [customerId], references: [id])
  promotionId    Int
  promotion      Promotion @relation(fields: [promotionId], references: [id])
  pointsSpent    Int       @default(0)
  discountAmount Float
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([promotionId])
}

model DeliveryPlatform {
  id             Int                 @id @default(autoincrement())
  name           String
  branchId       Int
  branch         Branch              @relation(fields: [branchId], references: [id])
  deliveryPrices MenuDeliveryPrice[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([branchId])
}

model MenuDeliveryPrice {
  id                 Int              @id @default(autoincrement())
  menuItemId         Int
  menuItem           MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  deliveryPlatformId Int
  deliveryPlatform   DeliveryPlatform @relation(fields: [deliveryPlatformId], references: [id], onDelete: Cascade)
  price              Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([menuItemId, deliveryPlatformId])
  @@index([menuItemId])
  @@index([deliveryPlatformId])
}

// ============================================
// PLATFORM SETTINGS (Super Admin singleton)
// ============================================

model PlatformSetting {
  id            Int      @id @default(1)
  bankName      String   @default("")
  accountName   String   @default("")
  accountNumber String   @default("")
  qrCodeUrl     String?
  updatedAt     DateTime @updatedAt
}

// ============================================
// SUBSCRIPTION PLANS (Super Admin)
// ============================================

model SubscriptionPlan {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Float
  description  String?
  features     Json                 @default("[]")
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  brands       Brand[]
  transactions PaymentTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// ============================================
// PAYMENT TRANSACTIONS (Tenant Onboarding)
// ============================================

model PaymentTransaction {
  id        Int                      @id @default(autoincrement())
  brandId   Int
  brand     Brand                    @relation(fields: [brandId], references: [id])
  planId    Int
  plan      SubscriptionPlan         @relation(fields: [planId], references: [id])
  /// Price snapshot at time of purchase. Nullable only so pre-existing rows
  /// can fall back to plan.price; every new row always stores it.
  amount    Float?
  slipUrl   String
  note      String?
  status    PaymentTransactionStatus @default(PENDING)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([brandId])
  @@index([planId])
}

// ============================================
// SYSTEM HEALTH & DIAGNOSTICS
// ============================================

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model SystemLog {
  id         String   @id @default(uuid())
  level      LogLevel
  source     String // 'FRONTEND' | 'BACKEND' | 'DATABASE'
  module     String // e.g. 'Orders', 'Auth', 'DeliveryService'
  message    String
  stackTrace String?  @db.Text
  tenantId   String? // userId or brandId — identifies which tenant was affected
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

// ============================================
// MULTI-STAFF ACCESS CONTROL (A2-2 fix)
// ============================================

// Links non-owner users (CASHIER role) to a specific Branch.
// Allows multiple staff accounts to operate a branch without sharing the owner's credentials.
// A2-2: fixes "CASHIER role locked out" — ownership checks accept both brand.userId == caller
//        AND BranchUser records where userId == caller.
model BranchUser {
  id        Int      @id @default(autoincrement())
  branchId  Int
  userId    Int
  role      Role     @default(CASHIER)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([branchId, userId])
  @@index([branchId])
  @@index([userId])
}
